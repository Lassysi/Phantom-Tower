// 3.0.0：DLL 文件属性。构建脚本用 /d PBZ_KIND_AVRT / PBZ_KIND_MODULE 选名字和说明（默认运行库）
#include <winver.h>
#if defined(PBZ_KIND_AVRT)
#define PBZ_FILE "avrt.dll"
#define PBZ_DESC "PBZ Tower loader (forwards to the system avrt.dll)"
#elif defined(PBZ_KIND_MODULE)
#define PBZ_FILE "PBZTower.dll"
#define PBZ_DESC "PBZ Tower module"
#else
#define PBZ_FILE "PBZCore.dll"
#define PBZ_DESC "PBZ Tower runtime"
#endif
VS_VERSION_INFO VERSIONINFO
FILEVERSION 4,1,1,0
PRODUCTVERSION 4,1,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PBZ Tower Mod"
            VALUE "FileDescription", PBZ_DESC
            VALUE "FileVersion", "4.1.1.0"
            VALUE "InternalName", PBZ_FILE
            VALUE "OriginalFilename", PBZ_FILE
            VALUE "ProductName", "PBZ Tower (Phantom Blade Zero mod)"
            VALUE "ProductVersion", "4.1.1.0"
            VALUE "LegalCopyright", "PBZ Tower Mod"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

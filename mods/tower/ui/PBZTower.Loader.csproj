<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PBZTower</AssemblyName>
    <RootNamespace>PBZ.Tower.UI</RootNamespace>
    <Product>PBZTower</Product>
    <Version>0.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/fox.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Include="assets/fox.png" LogicalName="PBZTower.Fox.png" />
    <EmbeddedResource Include="assets/fox.ico" LogicalName="PBZTower.Fox.ico" />
  </ItemGroup>
  <ItemGroup Condition="'$(TowerPayload)' != ''">
    <EmbeddedResource Include="$(TowerPayload)" LogicalName="PBZTower.Payload.zip" />
  </ItemGroup>
  <Target Name="ExcludeDebugFiles" AfterTargets="ComputeFilesToPublish">
    <ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb' Or '%(ResolvedFileToPublish.Extension)' == '.xml'" /></ItemGroup>
  </Target>
</Project>
